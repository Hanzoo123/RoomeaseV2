# Copy this file to .env and fill in your own values. .env is ignored by git, and the web
# server refuses to serve it.

# ---------- Website development (npm run dev only) ----------
# The WAMP build finds the API and the admin panel next to itself, so these are only for
# the Vite dev server. (They can also go in .env.local.)

# Where WAMP serves this project. The dev server forwards the API (/backend/…) there.
ROOMEASE_WAMP_URL=http://localhost/RoomeaseV2/

# "false" keeps accounts in the browser like the first prototype (no WAMP needed).
VITE_USE_API=true

# ---------- PHP: the API and the admin panel ----------
# The same keys as the first RoomEase project, so its .env lines work here too.

# Gmail sends the password reset codes. The address mail comes from, and a 16-letter App
# Password for it (Google Account > Security > 2-Step Verification > App passwords), not
# the account's own password. Spaces in the App Password are fine.
#ROOMEASE_MAIL_USERNAME=you@gmail.com
#ROOMEASE_MAIL_PASSWORD=abcdefghijklmnop

# Gmail's port. 465 (the default) talks TLS at once; 587 connects first and starts TLS
# with STARTTLS (for networks that block 465).
#ROOMEASE_MAIL_PORT=465

# The sender's name shown in the inbox.
#ROOMEASE_MAIL_FROM_NAME=RoomEase

# Only if PHP can't check Gmail's certificate ("certificate verify failed"): the full path
# of https://curl.se/ca/cacert.pem on this computer.
#ROOMEASE_MAIL_CA_BUNDLE=C:/wamp64/cacert.pem

# When a code can't be emailed, show it on screen, only to someone browsing from this
# computer. Set to false before others can reach the site (including through ngrok).
#ROOMEASE_SHOW_RESET_CODES=true

# The database (WAMP's defaults shown). WAMP's MariaDB: ROOMEASE_DB_HOST=localhost;port=3307
#ROOMEASE_DB_HOST=localhost
#ROOMEASE_DB_NAME=roomease
#ROOMEASE_DB_USER=root
#ROOMEASE_DB_PASS=
