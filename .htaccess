# RoomEase on WAMP: serves the built website (dist/) at this folder's address and leaves
# the PHP admin panel (backend/) as it is. Needs Apache's rewrite_module (on in WAMP).
DirectoryIndex index.php

# No folder listings (WAMP shows them by default), here and in every folder below.
Options -Indexes

# Basic protection for every page and file: no framing by other sites (clickjacking), no
# guessing of file types, and other sites see only this site's address, not full links.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never hand out dotfiles: .env holds the Gmail App Password, .git the code history.
# (This applies to every folder below this one too.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RedirectMatch 404 (?i)/\.git(/|$)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The admin panel, the built files and the page server itself are served as they are.
  RewriteRule ^(backend|dist)(/|$) - [L]
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^index\.html$ index.php [L]

  # Scripts, styles, images and other files come from the build.
  # (This also keeps the source, database and config files out of reach.)
  RewriteRule ^(.+\.[A-Za-z0-9]+)$ dist/$1 [L]

  # Every page address (/, /rooms, /boarder/…) is the React app.
  RewriteRule ^ index.php [L]
</IfModule>
